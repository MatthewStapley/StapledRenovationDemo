---
// Shared shell for every demo room. Demo pages are never indexed: they show
// fictional brands and shouldn't surface in search as real businesses.
import "../styles/global.css";
import { asset } from "../data/assets";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#111111" />

    <link rel="icon" type="image/svg+xml" href={asset("/favicon.svg")} />
    <link rel="icon" href={asset("/favicon.ico")} sizes="any" />

    <!-- Bricolage Grotesque + Inter: the Stapled. demo bar.
         Newsreader + Hanken Grotesk: the FORM Bathrooms brand. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&family=Hanken+Grotesk:wght@400..600&family=Inter:wght@500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..400&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
